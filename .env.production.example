# VPS template for the legacy docker-compose.yml flow.
# For the newer production stack, prefer deploy/docker.env.example.

DNS_PORT=53
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Browser-visible API URL. Rebuild the frontend after changing it.
NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP:8000

ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_RANDOM_SECRET

JWT_EXPIRE_HOURS=24
CORS_ORIGINS=http://YOUR_SERVER_IP:3000
