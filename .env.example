# Port for the DNS server (default: 53)
# Use 5354 for local development to avoid conflicts with system DNS
DNS_PORT=53

# Port for the backend API (default: 8000)
BACKEND_PORT=8000

# Port for the web UI (default: 3000)
FRONTEND_PORT=3000

# Backend API URL as seen from the browser (used at frontend build time)
# For local development: http://localhost:8000
# For remote server: http://your-server-ip:8000 or https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Admin credentials for the web interface
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# Secret key for JWT token signing (CHANGE THIS in production!)
SECRET_KEY=change-me-to-a-random-secret-in-production

# JWT token lifetime in hours (default: 24)
JWT_EXPIRE_HOURS=24

# Allowed CORS origins (comma-separated, default: * for all)
# For production: http://your-server:3000
CORS_ORIGINS=*
