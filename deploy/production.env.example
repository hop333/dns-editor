# Native Ubuntu/PM2/nginx deployment template.
# For the Docker + Caddy production stack, use deploy/docker.env.example.

ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SECRET_KEY=CHANGE_ME_OPENSSL_RAND_HEX_32
JWT_EXPIRE_HOURS=24

BIND_HOST=127.0.0.1
ZONES_DIR=/etc/bind/zones
BIND_DIR=/etc/bind
RNDC_KEY_PATH=/etc/bind/rndc.key

CORS_ORIGINS=https://dns.example.com
NEXT_PUBLIC_API_URL=https://dns.example.com/api
